// Prisma schema for Via Trips Provider Panel (SQLite)
// Converted from apps/api/prisma/schema.prisma (postgres) — SQLite-safe:
//   - enums → plain String fields with default literals
//   - String[] → Json (array<string>) 
//   - Decimal → Float

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String?
  name               String
  role               String   @default("HotelOwner") // HotelOwner | BundleCreator | Admin
  phone              String?
  companyName        String?
  businessLicense    String?
  tourGuideLicense   String?
  yearsExperience    Int?
  languagesSpoken    String   @default("[]") // JSON-encoded array<string>
  avatarUrl          String?
  firebaseUid        String?  @unique
  kycStatus          String   @default("NotSubmitted") // NotSubmitted | Pending | Approved | Rejected
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycRejectionReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hotels   Hotel[]
  bundles  Bundle[]
  bookings Booking[]
  kycDocs  KycDocument[]
  carCompanies CarCompany[]
  carBookings  CarBooking[]

  @@map("users")
}

model KycDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // BusinessLicense | IdProof | TaxCertificate | HotelLicense | PropertyOwnership | TourGuideLicense
  fileUrl    String
  fileName   String
  mimeType   String
  status     String   @default("NotSubmitted")
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("kyc_documents")
}

model Hotel {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String
  starRating  Int
  location    String
  city        String?
  latitude    Float?
  longitude   Float?
  amenities   String   @default("[]") // JSON-encoded array<string>
  images      String   @default("[]") // JSON-encoded array<string>
  policies    String?  // JSON-encoded policies object
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms    Room[]
  bookings Booking[]
  staff    Staff[]
  cameras  Camera[]
  tasks    StaffTask[]
  maintenanceRequests MaintenanceRequest[]
  guestProfiles GuestProfile[]
  checkIns CheckIn[]
  inventoryItems InventoryItem[]

  @@map("hotels")
}

model Room {
  id             String   @id @default(cuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType       String
  bedType        String
  maxGuests      Int
  pricePerNight  Float
  size           Float?
  amenities      String   @default("[]") // JSON-encoded array<string>
  images         String   @default("[]") // JSON-encoded array<string>
  totalUnits     Int      @default(1)
  availableUnits Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]
  maintenanceRequests MaintenanceRequest[]
  checkIns CheckIn[]
  statusLogs RoomStatusLog[]

  @@map("rooms")
}

model Bundle {
  id               String   @id @default(cuid())
  creatorId        String
  creator          User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String
  durationDays     Int
  destinations     String   @default("[]") // JSON-encoded array<string>
  images           String   @default("[]") // JSON-encoded array<string>
  guideName        String?
  price            Float
  difficulty       String   @default("easy")
  groupSize        Int?
  includedServices String   @default("[]") // JSON-encoded array<string>
  status           String   @default("Draft") // Draft | Published | Archived | SoldOut
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  days     BundleDay[]
  bookings Booking[]

  @@map("bundles")
}

model BundleDay {
  id          String   @id @default(cuid())
  bundleId    String
  bundle      Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items BundleItem[]

  @@map("bundle_days")
}

model BundleItem {
  id               String   @id @default(cuid())
  bundleDayId      String
  bundleDay        BundleDay @relation(fields: [bundleDayId], references: [id], onDelete: Cascade)
  type             String
  title            String
  description      String?
  startTime        String?
  endTime          String?
  location         String?
  cost             Float?
  includedServices String   @default("[]") // JSON-encoded array<string>
  metadata         String?  // JSON-encoded metadata object
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("bundle_items")
}

model Booking {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // HotelRoom | Bundle
  hotelId      String?
  hotel        Hotel?  @relation(fields: [hotelId], references: [id])
  roomId       String?
  room         Room?   @relation(fields: [roomId], references: [id])
  bundleId     String?
  bundle       Bundle? @relation(fields: [bundleId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  numGuests    Int      @default(1)
  totalAmount  Float
  status       String   @default("Pending") // Pending | Confirmed | Active | Completed | Cancelled | Refunded
  metadata     String?  // JSON-encoded metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("bookings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // booking | payment | verification | reviews | system | reminders
  titleEn   String
  titleAr   String
  bodyEn    String
  bodyAr    String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  targetType String // hotel | bundle
  rating    Int
  commentEn String?
  commentAr String?
  author    String
  createdAt DateTime @default(now())

  @@map("reviews")
}

// ───────────────────────────────────────────────────────────
// Operations: Staff + Tasks + Shifts + Salaries
// ───────────────────────────────────────────────────────────

model Staff {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  nameAr       String?
  phone        String?
  role         String   @default("staff") // staff | supervisor | manager
  department   String   @default("housekeeping") // housekeeping | maintenance | front_desk | security | kitchen | logistics
  hotelId      String?  // assigned hotel (if hotel-specific staff)
  hotel        Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  avatarUrl    String?
  baseSalary   Float    @default(3000)
  hourlyRate   Float    @default(25)
  isActive     Boolean  @default(true)
  hiredAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks     StaffTask[]
  shifts    StaffShift[]
  salaries  SalaryPayment[]
  maintenanceAssigned MaintenanceRequest[]

  @@map("staff")
}

model StaffTask {
  id           String   @id @default(cuid())
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  assignedBy   String   // userId (admin/manager)
  hotelId      String?
  hotel        Hotel?   @relation(fields: [hotelId], references: [id])
  type         String   // cleaning | maintenance | delivery | inspection | setup | other
  title        String
  description  String?
  location     String?  // e.g. "Room 502", "Lobby", "Pool area"
  priority     String   @default("normal") // low | normal | high | urgent
  status        String  @default("pending") // pending | in_progress | completed | cancelled
  assignedAt   DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  dueAt        DateTime?
  notes        String?  // staff notes when updating status
  photoUrl     String?  // optional before/after photo
  cameraId     String?  // future camera integration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("staff_tasks")
}

model StaffShift {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime?
  breakMins Int      @default(0)
  location  String?
  notes     String?
  createdAt DateTime @default(now())

  @@map("staff_shifts")
}

model SalaryPayment {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount     Float
  period     String   // e.g. "2026-09" or "2026-W38"
  bonus      Float    @default(0)
  deductions Float    @default(0)
  status     String   @default("pending") // pending | paid | cancelled
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime @default(now())

  @@map("salary_payments")
}

model Camera {
  id        String   @id @default(cuid())
  name      String
  location  String
  hotelId   String?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  streamUrl String?  // future RTSP/HLS URL
  status    String   @default("offline") // online | offline | maintenance
  createdAt DateTime @default(now())

  @@map("cameras")
}

// ───────────────────────────────────────────────────────────
// Car Rental Module
// ───────────────────────────────────────────────────────────

model CarCompany {
  id          String   @id @default(cuid())
  ownerId     String   // userId (provider)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  logo        String?
  phone       String?
  email       String?
  city        String?
  rating      Float    @default(4.5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cars     Car[]
  bookings CarBooking[]

  @@map("car_companies")
}

model Car {
  id          String   @id @default(cuid())
  companyId   String
  company     CarCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  make        String
  model       String
  year        Int
  plateNumber String?
  category    String   // economy | sedan | suv | luxury | van | sports
  transmission String  @default("automatic") // automatic | manual
  seats       Int      @default(5)
  doors       Int      @default(4)
  bags        Int      @default(2)
  ac          Boolean  @default(true)
  fuelType    String   @default("petrol") // petrol | diesel | hybrid | electric
  pricePerDay Float
  deposit     Float    @default(500)
  images      String   @default("[]")
  features    String   @default("[]") // JSON-encoded
  available   Boolean  @default(true)
  mileage     Int?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings CarBooking[]

  @@map("cars")
}

model CarBooking {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  companyId   String
  company     CarCompany @relation(fields: [companyId], references: [id])
  guestName   String
  guestEmail  String
  guestPhone  String
  pickupLocation String?
  dropoffLocation String?
  startDate   DateTime
  endDate     DateTime
  days        Int
  totalAmount Float
  deposit     Float    @default(0)
  status      String   @default("pending") // pending | confirmed | active | completed | cancelled
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("car_bookings")
}

// ───────────────────────────────────────────────────────────
// Front Desk & Room Operations
// ───────────────────────────────────────────────────────────

model MaintenanceRequest {
  id           String   @id @default(cuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId       String?
  room         Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedBy   String   // userId or "guest" or "staff:<id>"
  assignedTo   String?  // staffId
  staff       Staff?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  title        String
  description  String?
  location     String?
  priority     String   @default("normal") // low | normal | high | urgent
  status       String   @default("open") // open | in_progress | resolved | closed
  category     String   @default("other") // electrical | plumbing | hvac | furniture | appliance | structural | other
  photoUrl     String?
  reportedAt   DateTime @default(now())
  startedAt    DateTime?
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("maintenance_requests")
}

model GuestProfile {
  id              String   @id @default(cuid())
  hotelId         String?
  hotel           Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  name            String
  nameAr          String?
  email           String?
  phone           String?
  nationality     String?
  idType          String?  // passport | national_id | driving_license
  idNumber        String?
  dob             DateTime?
  gender          String?  // male | female | other
  address         String?
  city            String?
  country         String?
  preferences      String   @default("[]") // JSON-encoded preferences like ["non-smoking", "high floor"]
  dietaryNeeds    String?  // vegetarian | vegan | halal | kosher | none
  vipStatus       String   @default("regular") // regular | silver | gold | platinum
  totalStays      Int      @default(0)
  totalSpent      Float    @default(0)
  lastStayAt      DateTime?
  blacklisted     Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  checkIns CheckIn[]

  @@map("guest_profiles")
}

model CheckIn {
  id              String   @id @default(cuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestId         String?
  guest           GuestProfile? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  bookingId       String?
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guestName       String
  guestEmail      String?
  guestPhone      String?
  numGuests       Int      @default(1)
  checkInAt       DateTime @default(now())
  expectedCheckOut DateTime
  actualCheckOut  DateTime?
  status          String   @default("checked_in") // checked_in | checked_out | no_show | cancelled
  roomNumber      String?
  keyCardCount    Int      @default(1)
  depositCollected Float   @default(0)
  specialRequests String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("check_ins")
}

model InventoryItem {
  id           String   @id @default(cuid())
  hotelId      String
  hotel        Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name         String
  nameAr       String?
  category     String    // linens | toiletries | cleaning | food | beverage | office | other
  unit         String    @default("piece") // piece | box | kg | liter | roll | set
  quantity     Int       @default(0)
  minStock     Int       @default(10)
  maxStock     Int       @default(100)
  unitCost     Float     @default(0)
  supplier     String?
  location     String?   // storage room name
  barcode      String?
  lastRestockedAt DateTime?
  lastRestockQty Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String   // in | out | adjust | waste
  quantity  Int
  reason    String?
  staffId   String?
  createdAt DateTime @default(now())

  @@map("inventory_transactions")
}

model RoomStatusLog {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status    String   // clean | dirty | inspected | occupied | out_of_order
  notes     String?
  changedBy String?
  createdAt DateTime @default(now())

  @@map("room_status_logs")
}

# For Neon PostgreSQL:
# 1. DATABASE_URL = Pooled connection string (for the app runtime)
#    In Neon dashboard, use the connection with "pooler" in the host
#    Example: postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# 2. DIRECT_URL = Direct connection string (for prisma db push / migrations)
#    In Neon dashboard, use the connection WITHOUT "pooler" in the host
#    Example: postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Get both from: Neon Dashboard → your project → Connection Details → 
#   - Toggle "Connection pooling" ON → copy as DATABASE_URL
#   - Toggle "Connection pooling" OFF → copy as DIRECT_URL
#
# IMPORTANT: Replace PASSWORD with your actual Neon password
# IMPORTANT: Remove "&channel_binding=require" from both URLs if present

DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-divine-night-b5dwat0r-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-divine-night-b5dwat0r.region.aws.neon.tech/neondb?sslmode=require"

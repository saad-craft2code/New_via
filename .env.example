# Neon PostgreSQL connection strings
# Get these from: Neon Dashboard → your project → Connection Details
#
# DATABASE_URL = Pooled connection (for app runtime) - has "pooler" in host
# DIRECT_URL = Direct connection (for migrations) - no "pooler" in host
#
# Remove "&channel_binding=require" from URLs if present

DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
